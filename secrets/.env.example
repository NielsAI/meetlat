# Endpoint credentials for `meetlat run` (build step 5).
#
# Copy this to secrets/.env and fill it in. Everything in secrets/ is gitignored
# except this example, so the real file cannot be committed by accident.
#
#     cp secrets/.env.example secrets/.env
#     $EDITOR secrets/.env
#
# Load it into a shell without echoing it, then run:
#
#     set -a; . ./secrets/.env; set +a
#     make run ARGS="--seed 2026 --limit 20"
#
# `set -a` exports every variable the file defines; `set +a` stops that applying to
# whatever you type next. Nothing here reaches a shell history, because you never type
# the key: the runner reads these three variables from the environment and writes none
# of them into a run record, a log line or an error message.
#
# On a shared or multi-user machine, note that a process environment is readable by
# root and by your own other processes. If that matters, use a key scoped to this
# project that you can revoke on its own.


# Any OpenAI-compatible endpoint, up to and including /v1. No trailing slash needed;
# the runner strips one. The path /chat/completions is appended by the client.
#
#   Anthropic:  https://api.anthropic.com/v1
#   OpenAI:     https://api.openai.com/v1
#   local:      http://127.0.0.1:11434/v1
MEETLAT_BASE_URL=https://api.example.com/v1

# The credential for that endpoint. Paste it here and nowhere else.
# Keep the quotes off unless the value contains a space.
MEETLAT_API_KEY=paste-your-key-here

# The model to generate responses with, exactly as the endpoint names it.
# ADR-0003 pins model and temperature because a response set nobody can attribute to a
# configuration cannot be compared with anything, including itself a month later. This
# value is recorded on every response, so changing it starts a new comparison rather
# than continuing the old one.
MEETLAT_MODEL=replace-with-a-model-id
