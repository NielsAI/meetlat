# Run output: reports are reproducible from a checkpoint plus a prompt seed, so
# they are artifacts, not sources. Judge cards and gold sets are sources and are
# deliberately NOT ignored.
runs/
*.local.json
.env

# Endpoint credentials for `meetlat run`. Everything in secrets/ is ignored except the
# example, rather than ignoring `secrets/*.env`: a deny-list here fails open, and the
# file that gets committed by accident is always the one whose name nobody predicted.
secrets/*
!secrets/.env.example

